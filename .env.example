# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Contact Form Email Provider (Resend is recommended for Vercel)
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=re_your_api_key_here

# (Optional) The email address verified in your Resend account to send from
# By default, Resend onboarding allows "onboarding@resend.dev" for testing
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Destination email where contact messages are forwarded
# Defaults to info@anupam-dhakal.com.np as configured in src/config/site.ts
CONTACT_DESTINATION_EMAIL=info@anupam-dhakal.com.np

# (Optional) GitHub Personal Access Token to raise GitHub API rate limits
# (Useful if you have many projects or frequent deployments)
GITHUB_TOKEN=
